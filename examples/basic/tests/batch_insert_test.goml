package tests;

use ecosystem::cache;
use std::testing;

#[test]
fn consumer_inserts_a_typed_batch() -> () {
    let values: cache::Cache[string, isize] = testing::expect_ok(
        cache::Cache::new(cache::Options::new(2)),
        "cache",
    );
    let previous = testing::expect_ok(
        values.insert_many(
            Vec::from_array(
                [
                    ("first", cache::Loaded::new(10, 1)),
                    ("second", cache::Loaded::new(20, 1)),
                    ("first", cache::Loaded::new(30, 1)),
                ],
            ),
        ),
        "insert",
    );
    testing::assert(previous == Vec::from_array([Option::None, Option::None, Option::Some(10)]));
    testing::assert(
        testing::expect_ok(values.peek_many(Vec::from_array(["first", "second"])), "read")
            == Vec::from_array([Option::Some(30), Option::Some(20)]),
    );
}
