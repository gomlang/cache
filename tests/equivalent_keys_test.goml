package tests;

use ecosystem::cache;
use std::context;
use std::testing;

struct AliasKey {
    id: isize,
    label: string,
}

impl PartialEq for AliasKey {
    fn eq(self: AliasKey, other: AliasKey) -> bool {
        self.id == other.id
    }
}

impl Eq for AliasKey {}

impl Hash for AliasKey {
    fn hash(self: AliasKey) -> u64 {
        Hash::hash(self.id)
    }
}

#[test]
fn touching_equal_keys_preserves_the_latest_key_in_lru_and_removals() -> () {
    for size in Vec::from_array([1, 3]) {
        for operation in 0..4 {
            let removed = Vec::new();
            let values: cache::Cache[AliasKey, string] = testing::expect_ok(
                cache::Cache::with_policy(
                    cache::Options::new(size),
                    |value: string| value,
                    |key: AliasKey, _, _| removed.push(key.label),
                ),
                "cache",
            );
            for id in 0..size {
                testing::assert_ok(values.insert(AliasKey { id, label: "original" }, "value", 1));
            }
            let key = AliasKey { id: size - 1, label: "alias" };
            if operation == 0 {
                testing::assert_ok(values.get(key));
            } else if operation == 1 {
                testing::assert_ok(
                    values.get_many(Vec::from_array([AliasKey { label: "first", ..key }, key])),
                );
            } else if operation == 2 {
                testing::assert_ok(
                    values.get_or_try_insert_with(
                        context::Context::background(),
                        key,
                        |_| Result::Err(cache::Error::Loader("expected a cache hit")),
                    ),
                );
                testing::assert_eq(values.stats().loads, 0);
            } else {
                testing::assert_ok(values.peek(key));
            }
            let expected = if operation == 3 {
                "original"
            } else {
                "alias"
            };
            let keys = testing::expect_ok(values.keys_lru(), "keys");
            testing::assert_eq(keys[size - 1].label, expected);
            testing::assert_ok(values.clear());
            testing::assert_eq(removed.len(), size);
            testing::assert(removed.contains(expected));
        }
    }
}
