package tests;

use ecosystem::cache;
use std::context;
use std::task;
use std::testing;

#[test]
fn batch_inserts_apply_duplicates_and_capacity_in_input_order() -> () {
    let values: cache::Cache[isize, string] = testing::expect_ok(
        cache::Cache::new(cache::Options { max_weight: 3, ..cache::Options::new(2) }),
        "cache",
    );
    testing::assert_ok(values.insert(1, "old", 1));
    let previous = testing::expect_ok(
        values.insert_many(
            Vec::from_array(
                [
                    (1, cache::Loaded::new("one", 1)),
                    (2, cache::Loaded::new("two", 2)),
                    (1, cache::Loaded::new("again", 1)),
                    (3, cache::Loaded::new("three", 2)),
                ],
            ),
        ),
        "batch",
    );
    testing::assert(
        previous
            == Vec::from_array(
                [Option::Some("old"), Option::None, Option::Some("one"), Option::None],
            ),
    );
    testing::assert(testing::expect_ok(values.keys_lru(), "keys") == Vec::from_array([1, 3]));
    testing::assert_eq(values.stats().weight, 3);
    testing::assert_eq(values.stats().insertions, 5);
    testing::assert_eq(values.stats().evictions, 1);
    testing::assert_eq(testing::expect_ok(values.insert_many(Vec::new()), "empty").len(), 0);
    values.close();
    testing::assert_err(values.insert_many(Vec::new()));
}

#[test]
fn invalid_batches_do_not_copy_sample_expire_or_mutate() -> () {
    let samples = Ref::new(0);
    let copies = Ref::new(0);
    let notifications = Ref::new(0);
    let now = Ref::new(0);
    let values: cache::Cache[isize, string] = testing::expect_ok(
        cache::Cache::with_policy(
            cache::Options {
                clock: cache::Clock::new(
                    || {
                        samples.set(samples.get() + 1);
                        now.get()
                    },
                ),
                max_weight: 3,
                ..cache::Options::new(2),
            },
            |value: string| {
                copies.set(copies.get() + 1);
                value
            },
            |_, _, _| notifications.set(notifications.get() + 1),
        ),
        "cache",
    );
    testing::assert_ok(values.insert_with_expiry(1, "old", 1, cache::Expiry::ttl(1)));
    now.set(1);
    let before_samples = samples.get();
    let before_copies = copies.get();
    for invalid in Vec::from_array(
        [
            cache::Loaded::new("invalid", -1),
            cache::Loaded::new("invalid", 4),
            cache::Loaded::new("invalid", 1).with_expiry(cache::Expiry::ttl(-1)),
        ],
    ) {
        testing::assert_err(
            values.insert_many(Vec::from_array([(1, cache::Loaded::new("new", 1)), (2, invalid)])),
        );
    }
    testing::assert_eq(samples.get(), before_samples);
    testing::assert_eq(copies.get(), before_copies);
    testing::assert_eq(notifications.get(), 0);
    now.set(0);
    testing::assert(testing::expect_ok(values.peek(1), "unchanged") == Option::Some("old"));
    testing::assert_eq(values.stats().insertions, 1);
    testing::assert_eq(values.stats().expirations, 0);
}

#[test]
fn batch_inserts_copy_values_and_notify_after_commit_with_one_clock_sample() -> () {
    let slot: Ref[Option[cache::Cache[isize, Vec[isize]]]] = Ref::new(Option::None);
    let samples = Ref::new(0);
    let clock = cache::ManualClock::new();
    let notifications = Ref::new(0);
    let values: cache::Cache[isize, Vec[isize]] = testing::expect_ok(
        cache::Cache::with_policy(
            cache::Options {
                clock: cache::Clock::new(
                    || {
                        samples.set(samples.get() + 1);
                        clock.now()
                    },
                ),
                ..cache::Options::new(3),
            },
            |value: Vec[isize]| value.copy(),
            |_, value, _| {
                if let Some(values) = slot.get() {
                    testing::assert(
                        testing::expect_ok(values.peek(1), "committed first")
                            == Option::Some(Vec::from_array([11])),
                    );
                    testing::assert(
                        testing::expect_ok(values.peek(2), "committed second")
                            == Option::Some(Vec::from_array([22])),
                    );
                    value[0] = 999;
                    notifications.set(notifications.get() + 1);
                }
            },
        ),
        "cache",
    );
    testing::assert_ok(values.insert(1, Vec::from_array([1]), 1));
    testing::assert_ok(values.insert(2, Vec::from_array([2]), 1));
    slot.set(Option::Some(values));
    let incoming = Vec::from_array([11]);
    let old = testing::expect_ok(
        values.insert_many(
            Vec::from_array(
                [
                    (1, cache::Loaded::new(incoming, 1).with_expiry(cache::Expiry::ttl(2))),
                    (2, cache::Loaded::new(Vec::from_array([22]), 1)),
                ],
            ),
        ),
        "batch",
    );
    testing::assert_eq(notifications.get(), 2);
    testing::assert(
        old
            == Vec::from_array(
                [Option::Some(Vec::from_array([1])), Option::Some(Vec::from_array([2]))],
            ),
    );
    incoming[0] = 77;
    testing::assert(
        testing::expect_ok(values.peek(1), "copied") == Option::Some(Vec::from_array([11])),
    );
    slot.set(Option::None);
    samples.set(0);
    testing::assert_ok(
        values.insert_many(
            Vec::from_array(
                [
                    (
                        3,
                        cache::Loaded::new(Vec::from_array([3]), 0).with_expiry(
                            cache::Expiry::until(0),
                        ),
                    ),
                ],
            ),
        ),
    );
    testing::assert_eq(samples.get(), 1);
    testing::assert_none(testing::expect_ok(values.peek(3), "already expired"));
    testing::assert_ok(clock.advance(2));
    testing::assert_none(testing::expect_ok(values.peek(1), "ttl"));
}

#[test]
fn rejected_batches_preserve_loads_and_successful_batches_invalidate_them() -> () {
    let values: cache::Cache[isize, string] = testing::expect_ok(
        cache::Cache::new(cache::Options::new(3)),
        "cache",
    );
    for reject in Vec::from_array([true, false]) {
        let started: Channel[()] = Channel::new(0);
        let release: Channel[()] = Channel::new(0);
        task::scope(
            |scope| {
                let worker = scope.spawn(
                    |_| values.get_or_try_insert_with(
                        context::Context::background(),
                        1,
                        |_| {
                            started.send(());
                            let _ = release.recv();
                            Result::Ok(cache::Loaded::new("loaded", 1))
                        },
                    ),
                );
                let _ = started.recv();
                if reject {
                    testing::assert_err(
                        values.insert_many(
                            Vec::from_array(
                                [
                                    (1, cache::Loaded::new("replacement", 1)),
                                    (2, cache::Loaded::new("bad", -1)),
                                ],
                            ),
                        ),
                    );
                } else {
                    testing::assert_ok(
                        values.insert_many(
                            Vec::from_array(
                                [
                                    (1, cache::Loaded::new("replacement", 1)),
                                    (2, cache::Loaded::new("second", 1)),
                                ],
                            ),
                        ),
                    );
                }
                release.close();
                if reject {
                    testing::assert_eq(testing::expect_ok(worker.join(), "load survived"), "loaded");
                } else {
                    testing::assert_eq(
                        testing::expect_err(worker.join(), "invalidated"),
                        cache::Error::Invalidated,
                    );
                }
            },
        );
        if !reject {
            testing::assert(
                testing::expect_ok(values.peek(1), "replacement") == Option::Some("replacement"),
            );
        }
        testing::assert_ok(values.remove(1));
    }
}

#[test]
fn batch_insert_snapshots_entries_before_reentrant_copies() -> () {
    for clear in Vec::from_array([false, true]) {
        let entries = Vec::from_array(
            [(1, cache::Loaded::new("one", 1)), (2, cache::Loaded::new("two", 1))],
        );
        let slot: Ref[Option[cache::Cache[isize, string]]] = Ref::new(Option::None);
        let values: cache::Cache[isize, string] = testing::expect_ok(
            cache::Cache::with_policy(
                cache::Options::new(2),
                |value: string| {
                    if value == "one" {
                        if clear {
                            entries.clear();
                        } else {
                            entries[1] = (99, cache::Loaded::new("invalid", -1));
                        }
                    }
                    if let Some(values) = slot.get() {
                        let _ = values.stats();
                    }
                    value
                },
                |_, _, _| (),
            ),
            "cache",
        );
        slot.set(Option::Some(values));
        let previous = testing::expect_ok(values.insert_many(entries), "snapshot batch");
        testing::assert(previous == Vec::from_array([Option::None, Option::None]));
        slot.set(Option::None);
        testing::assert(testing::expect_ok(values.keys_lru(), "keys") == Vec::from_array([1, 2]));
        testing::assert_eq(values.stats().weight, 2);
        testing::assert(testing::expect_ok(values.peek(2), "second") == Option::Some("two"));
    }
}
